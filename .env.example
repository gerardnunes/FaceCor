# Copie para .env:  cp .env.example .env

# Endereço pelo qual o sistema será acessado.
#  - Rede interna / teste:  localhost  ou  o IP/nome do servidor (ex.: 192.168.0.10, cor.local)
#  - Internet com domínio próprio (certificado Let's Encrypt automático): cor.suaempresa.com.br
DOMAIN=localhost

# Certificado: "local_certs" = certificado interno (rede interna/IP).
# Deixe VAZIO se DOMAIN for um domínio público (portas 80/443 abertas) para usar Let's Encrypt.
CADDY_GLOBAL=local_certs

# Fuso horário
TZ=America/Sao_Paulo

# Rigor do reconhecimento (similaridade 0-1). Maior = mais rígido. Padrão 0.40.
FACE_THRESHOLD=0.40
# Segundos para ignorar leituras repetidas da mesma pessoa
FACE_COOLDOWN_SEG=15

# Opcionais (se vazios, são gerados e guardados no volume de dados):
# SETUP_TOKEN=
# SECRET_KEY=
# FIELD_ENCRYPTION_KEY=
